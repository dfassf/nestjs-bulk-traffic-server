# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
UV_THREADPOOL_SIZE=64
DISABLE_WORKERS=false
ALLOW_CUSTOM_WORKLOAD=false
WORKER_POOL_SIZE=4
WORKER_MAX_CPU_CONCURRENCY=4
WORKER_MAX_MEMORY_CONCURRENCY=2
WORKER_MAX_CUSTOM_CONCURRENCY=2
QUEUE_PERSISTENCE=none
QUEUE_SNAPSHOT_PATH=.queue-snapshot.json
QUEUE_SNAPSHOT_INTERVAL_MS=30000
QUEUE_SNAPSHOT_MAX_AGE_MS=300000

# Queue core tuning (recommended runtime knobs)
QUEUE_CONCURRENT_TASKS=50
QUEUE_MAX_CONCURRENT_REQUESTS=200
QUEUE_TASK_TIMEOUT_MS=15000
QUEUE_EXECUTION_TIMEOUT_MS=10000
QUEUE_OVERFLOW_THRESHOLD=3000
QUEUE_PROCESS_INTERVAL_MS=20
QUEUE_MEMORY_CHECK_INTERVAL_MS=3000
QUEUE_STATS_LOG_INTERVAL_MS=60000

# Worker engine selector: node | go | both | kafka
WORKER_ENGINE=node

# Go engine sidecar (WORKER_ENGINE=go|both)
GO_ENGINE_HOST=localhost
GO_ENGINE_PORT=50051

# Kafka producer backend (WORKER_ENGINE=kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bulk-traffic-producer

# 주문 이벤트 (카프카 실험용). 자세한 배경은 docs/kafka-lab-plan.md
ORDER_DB_PATH=.orders.sqlite
ORDER_PRODUCER_CLIENT_ID=order-publisher
# 토픽 파티션 수. 컨슈머 병렬성의 상한이라 실험의 핵심 변수다.
ORDER_TOPIC_PARTITIONS=6
ORDER_TOPIC_REPLICATION_FACTOR=1
# 아래 셋은 실험용 스위치다. 평소에는 건드리지 않는다.
#   중복 실험: 프로듀서 재시도로 생기는 브로커 중복을 보려면 false
ORDER_PRODUCER_IDEMPOTENT=true
#   멱등성을 끈 경우에만 의미가 있다 (-1=전체 확인, 1=리더만, 0=확인 안 함)
ORDER_PRODUCER_ACKS=-1
#   순서 붕괴 실험: 키 없이 발행해 파티션이 흩어지는 것을 보려면 true
ORDER_PRODUCER_DISABLE_KEY=false

# 주문 이벤트 컨슈머 (별도 프로세스: npm run consumer)
CONSUMER_GROUP_ID=order-processor
CONSUMER_CLIENT_ID=order-consumer
# 이 프로세스에서 띄울 컨슈머 개수. 파티션 수를 넘기면 남는 컨슈머는 논다.
CONSUMER_COUNT=1
# 구독 토픽. 비우면 주문 토픽 전부.
CONSUMER_TOPICS=
# 한 건 처리에 걸리는 시간을 흉내낸다. Lag 을 쌓을 때 올린다.
CONSUMER_DELAY_MS=0
# 오프셋 커밋 시점: after-process(중복 감수) | before-process(유실 감수)
CONSUMER_COMMIT_MODE=after-process
# 처리와 커밋 사이 간격. 이 창에서 프로세스를 죽이면 중복이 재현된다.
CONSUMER_COMMIT_DELAY_MS=0
# 처음부터 다시 읽는다. 새 그룹으로 과거를 재생할 때.
CONSUMER_FROM_BEGINNING=false
# 이 건수만큼 처리하면 커밋 없이 스스로 죽는다. 0이면 안 죽는다.
CONSUMER_CRASH_AFTER=0
CONSUMER_REPORT_INTERVAL_MS=10000

# Benchmark storage driver: sqlite | postgresql
BENCH_DB_DRIVER=sqlite
BENCH_DB_PATH=.bench.sqlite

# PostgreSQL benchmark target (BENCH_DB_DRIVER=postgresql 일 때 전부 필수)
# 접속 대상은 기본값을 두지 않는다. 값이 없으면 부팅에서 실패한다.
BENCH_PG_HOST=localhost
BENCH_PG_PORT=5432
BENCH_PG_DATABASE=bench
BENCH_PG_USER=bench
BENCH_PG_PASSWORD=bench
BENCH_PG_POOL_SIZE=10
