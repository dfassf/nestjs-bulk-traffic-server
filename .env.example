# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
UV_THREADPOOL_SIZE=64

# Queue core tuning (recommended runtime knobs)
QUEUE_CONCURRENT_TASKS=50
QUEUE_MAX_CONCURRENT_REQUESTS=200
QUEUE_TASK_TIMEOUT_MS=15000
QUEUE_EXECUTION_TIMEOUT_MS=10000
QUEUE_OVERFLOW_THRESHOLD=3000
QUEUE_PROCESS_INTERVAL_MS=20
QUEUE_MEMORY_CHECK_INTERVAL_MS=3000
QUEUE_STATS_LOG_INTERVAL_MS=60000
